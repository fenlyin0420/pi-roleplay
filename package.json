{
  "name": "@fenlyin/pi-roleplay",
  "version": "0.1.0",
  "description": "Pi 的角色扮演模式：整套 system prompt 替换、SillyTavern 资产兼容、世界书按需注入、RP 工具集",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "docs": "ls docs"
  },
  "files": [
    "src/",
    "examples/",
    "docs/USAGE.md",
    "docs/FORMAT.md",
    "docs/ST-COMPAT.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.3",
    "typebox": "*",
    "typescript": "^5.9.3"
  },
  "author": "fenlyin0420",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenlyin0420/pi-roleplay.git"
  },
  "homepage": "https://github.com/fenlyin0420/pi-roleplay#readme",
  "bugs": {
    "url": "https://github.com/fenlyin0420/pi-roleplay/issues"
  }
}
